  "entry": {
    "id": "one-to-many",
    "version": 1,
    "name": "One to many",
    "description": "A single image grows into a staggered array, with a shared camera drift and a title.",
    "tags": [
      "images",
      "stagger",
      "explainers"
    ],
    "origin": "Generalized from our authored MIT motion-study recipes, inspired by the user-supplied FROM BILLIONS TO NOTHING OVERNIGHT reference. No reference footage, source cutouts, narration, or approval is distributed.",
    "limitations": [
      "New assets and dimensions need fresh visual review; this is a reusable 2D structure, not recovered 3D.",
      "Source-specific image masks were removed. Use a licensed transparent cutout or author a new mask for the new subject.",
      "A contained layout preserves geometry across aspect ratios but may need manual reframing.",
      "Font availability and speech timestamps must be checked locally. No publication approval is included."
    ],
    "requirements": {
      "framing": "New media stays aspect-correct; intended subject and caption area remain visible.",
      "typography": "Supplied titles and source-aligned words are readable, separate, and preserve emphasis hierarchy.",
      "motion": "Repeated images enter in staggered waves; gentle group camera movement remains continuous.",
      "rhythm": "Holds and reveals follow the new shot and bound speech cues; inspect entrances, exits and cut boundaries."
    },
