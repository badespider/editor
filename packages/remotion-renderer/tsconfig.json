{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "jsx": "react-jsx", "verbatimModuleSyntax": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node", "react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
