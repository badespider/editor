{
  "name": "@diffusionstudio/jsx",
  "version": "0.1.0",
  "description": "JSX runtime, types, and declarative generated assets (`generate.*`) for authoring Diffusion Studio compositions — mounted into the editor via `dapi mount`.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test:presets": "node scripts/test-presets.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "keywords": [
    "diffusion-studio",
    "solid-js",
    "jsx",
    "generative-ai",
    "video-editing"
  ],
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "~5.9.3"
  }
}
